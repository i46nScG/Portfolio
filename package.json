{
    "name": "portfolio",
    "version": "1.0.0",
    "private": true,
    "description": "Portfolio website of Me, Tokioshy, built with Tailwind CSS.",
    "scripts": {
        "build": "npm run build:js && tailwindcss -i ./src/style.css -o ./public/assets/style.css --minify",
        "build:js": "node ./scripts/build.js",
        "watch:css": "tailwindcss -i ./src/style.css -o ./public/assets/style.css --watch",
        "watch:js": "node ./scripts/build.js --watch",
        "serve": "serve public -l 3000",
        "dev": "concurrently -k \"npm:watch:css\" \"npm:watch:js\" \"npm:serve\""
    },
    "devDependencies": {
        "concurrently": "^9.0.0",
        "serve": "^14.2.0",
        "tailwindcss": "3.4.17",
        "terser": "^5.51.2"
    }
}
