{
    "name": "portfolio",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "description": "Portfolio website of Me, Tokioshy, built with React, Vite, TypeScript, Tailwind CSS, Radix UI and Framer Motion.",
    "scripts": {
        "dev": "vite --port 3000",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --port 3000",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "framer-motion": "^14.14.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.7.0",
        "postcss": "^8.5.33",
        "tailwindcss": "3.4.17",
        "typescript": "~5.6.3",
        "vite": "^5.4.21"
    },
    "allowScripts": {
        "esbuild@0.21.5": true
    }
}
